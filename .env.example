# Memovo AI Service - example configuration
# Copy to .env and adjust. Never commit a real .env.
# All settings are prefixed MEMOVO_ and are read via pydantic-settings.

# `production` enables the production guards; see the vector provider below.
MEMOVO_ENV=development

# --- Operational logging (privacy-safe: counts, durations, ids and codes) ---
MEMOVO_LOG_LEVEL=INFO
# `json` for log aggregation, `text` for readable local output.
MEMOVO_LOG_FORMAT=json
# Mixed into the userId hash so a guessed userId cannot be confirmed from a
# log. Optional; leave blank for an unsalted hash. Supply through the secret
# store, and keep it stable or historical logs stop correlating.
MEMOVO_LOG_USER_SALT=

# --- Embeddings (locked: Qwen3-Embedding family, dimension 1024) ---
MEMOVO_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MEMOVO_EMBEDDING_DIMENSION=1024
# auto lets the runtime pick CUDA when present, otherwise CPU.
MEMOVO_EMBEDDING_DEVICE=auto
MEMOVO_EMBEDDING_BATCH_SIZE=32
# Query instruction prompt name, applied to queries only. Empty disables it.
# Enabled: the Phase 06 benchmark confirmed the model defines it and that it
# improves relevant-vs-unrelated separation.
MEMOVO_EMBEDDING_QUERY_PROMPT_NAME=query

# --- Hugging Face Hub (model download on a cold cache) ---
# Optional Hugging Face read token. Read by the huggingface_hub library
# itself; the service does not parse it. Recommended in hosted deployments to
# increase rate limits and reliability while downloading a cold model cache.
# A read-only token is sufficient: the model is public. Missing is not an
# application error; the download simply runs unauthenticated. Supply it
# through the deployment secret store and never commit a real value.
HF_TOKEN=

# --- Retrieval (locked MVP defaults - do not change without a product decision) ---
MEMOVO_SEARCH_TOP_K=5
MEMOVO_SEARCH_SIMILARITY_THRESHOLD=0.75

# --- Vector search provider (read-only) ---
# `fake` is the in-memory development default; `atlas` uses MongoDB Atlas.
#
# `fake` is REFUSED when MEMOVO_ENV=production: startup fails rather than
# serving an empty index.
#
# Two different mistakes, two different outcomes:
#   - variable NAME mistyped (MEMOVO_VECTOR_PROVIDR=atlas) -> the real
#     variable is unset, so `fake` is selected silently. This is the one the
#     production guard exists to catch.
#   - variable VALUE mistyped (MEMOVO_VECTOR_PROVIDER=atlss) -> matches no
#     known provider and fails at startup with an explicit error.
MEMOVO_VECTOR_PROVIDER=atlas

# --- MongoDB Atlas Vector Search (only when MEMOVO_VECTOR_PROVIDER=atlas) ---
# Connection string with credentials. NEVER commit a real value; this file is
# an example. Replace the placeholders locally or use the deployment secret store.
# The Backend-provided cluster uses the test database. Credentials are not included.
MEMOVO_ATLAS_URI=mongodb://<db_username>:<db_password>@ac-shqyhuc-shard-00-00.djcrspn.mongodb.net:27017,ac-shqyhuc-shard-00-01.djcrspn.mongodb.net:27017,ac-shqyhuc-shard-00-02.djcrspn.mongodb.net:27017/?ssl=true&replicaSet=atlas-clnkk1-shard-0&authSource=admin&appName=memovo&retryWrites=true&w=majority
MEMOVO_ATLAS_DATABASE=test
# Contract section 12 names. Override only if the Backend provisioned others.
MEMOVO_ATLAS_COLLECTION=memory_vectors
MEMOVO_ATLAS_INDEX=vector_index
# Document field holding the 1024-dimension vector.
MEMOVO_ATLAS_PATH=embedding
# Atlas explores numCandidates nodes before returning `limit` results.
MEMOVO_ATLAS_NUM_CANDIDATES_MULTIPLIER=10
MEMOVO_ATLAS_MIN_NUM_CANDIDATES=100
# Applied to server selection, connection and the query itself.
MEMOVO_ATLAS_TIMEOUT_MS=5000
# --- Answer generation (Memory Chat and note preparation) ---
# Disabled by default. Processing and search never need any of this. When
# enabled, the only provider is OpenRouter and the model is exactly the
# approved one: no paid, alternate or openrouter/free fallback is authorized.
# Keep the real key in the local .env or the deployment secret store, never
# here. Enabled without a key: startup logs generation.startup_failed and the
# chat/prepare-note endpoints answer 503 GENERATION_UNAVAILABLE.
MEMOVO_GENERATION_ENABLED=false
MEMOVO_GENERATION_PROVIDER=openrouter
MEMOVO_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MEMOVO_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MEMOVO_OPENROUTER_API_KEY=
# Provisional operating limits, re-baselined against the real endpoint.
# Deadline per generation call, including any wait for a concurrency slot.
MEMOVO_GENERATION_TIMEOUT_SECONDS=60
MEMOVO_GENERATION_MAX_CONCURRENCY=4
# Output caps sent as max_tokens: a chat answer, and a whole cleaned note.
MEMOVO_GENERATION_CHAT_MAX_OUTPUT_TOKENS=1024
MEMOVO_GENERATION_NOTE_MAX_OUTPUT_TOKENS=4096
# Context the budget check assumes, and a conservative chars-per-token
# estimate. History and evidence are never trimmed to fit; an over-budget
# request fails with 422 instead.
MEMOVO_GENERATION_CONTEXT_WINDOW_TOKENS=40960
MEMOVO_GENERATION_CHARS_PER_TOKEN=2.0
# Upper bound on a forwarded Retry-After for 429 RATE_LIMITED.
MEMOVO_GENERATION_RETRY_AFTER_MAX_SECONDS=30
